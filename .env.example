# ========================================================
# December 2026 MTC Batch - Environment Configuration
# ========================================================

# Port for local server (defaults to 3000)
PORT=3000

# Turso Cloud SQLite Configuration:
# To connect to Turso Cloud, set your database URL and Auth Token below:
# Obtain these with:
#   turso db create december-2026-mtc
#   turso db show december-2026-mtc --url
#   turso db tokens create december-2026-mtc
#
TURSO_DATABASE_URL=libsql://your-database-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# If TURSO_DATABASE_URL is left empty or points to a local file (e.g. file:data/batch.db),
# the app will automatically use local SQLite storage.
